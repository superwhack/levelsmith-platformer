// This code was generated by Claude, due to a lack of knowledge on the team about shaders.
shader_type canvas_item;

// 0.0 = fully hidden, 1.0 = fully visible
uniform float progress : hint_range(0.0, 1.0) = 0.0;

// Size of each dither "pixel" in screen pixels. Higher = chunkier dither.
uniform float dither_scale : hint_range(1.0, 16.0) = 4.0;

// Width of the dithered transition ring, as a fraction of the item's
// corner-to-center distance (0.15 = ring is 15% of that distance wide).
uniform float edge_softness : hint_range(0.01, 1.0) = 0.15;

// Center of the circle in UV space (0.5, 0.5 = middle of the item).
uniform vec2 center = vec2(0.5, 0.5);

// REQUIRED: the item's actual pixel size (e.g. sprite texture size * scale,
// or a Control's rect size). Set this from a script -- see notes below.
// Left at (1,1) it assumes a square item.
uniform vec2 item_size = vec2(1.0, 1.0);

// Classic 8x8 Bayer ordered-dither matrix, normalized 0..1
const int bayer_matrix_8x8[64] = int[](
    0, 32, 8, 40, 2, 34, 10, 42,
    48, 16, 56, 24, 50, 18, 58, 26,
    12, 44, 4, 36, 14, 46, 6, 38,
    60, 28, 52, 20, 62, 30, 54, 22,
    3, 35, 11, 43, 1, 33, 9, 41,
    51, 19, 59, 27, 49, 17, 57, 25,
    15, 47, 7, 39, 13, 45, 5, 37,
    63, 31, 55, 23, 61, 29, 53, 21
);

float get_bayer_value(vec2 screen_pos) {
    ivec2 pos = ivec2(mod(screen_pos, 8.0));
    int index = pos.y * 8 + pos.x;
    return float(bayer_matrix_8x8[index]) / 64.0;
}

void fragment() {
    vec4 tex_color = texture(TEXTURE, UV);

    // Work in real pixel distance instead of raw UV distance, so the
    // reveal shape isn't stretched by the item's aspect ratio.
    vec2 delta_px = (UV - center) * item_size;

    // Normalize each axis by its own half-extent, then take the max of the
    // two (Chebyshev distance) instead of the straight-line (Euclidean)
    // distance. This makes the level sets rectangles instead of circles --
    // both edges and corners land on axis_pos = 1.0 exactly at the item's
    // boundary, so a square/rect grows outward and fills perfectly.
    vec2 half_extent = item_size * 0.5;
    vec2 normalized_delta = abs(delta_px) / half_extent;
    float axis_pos = max(normalized_delta.x, normalized_delta.y);

    // Sweep the growing rectangle's edge from just inside the center (progress = 0,
    // nothing visible) to just past the item's boundary (progress = 1, fully visible).
    float threshold = progress * (1.0 + edge_softness) - edge_softness;
    float local_amount = clamp((axis_pos - threshold) / edge_softness, 0.0, 1.0);

    // Sample the dither threshold from screen-space pixel position so the
    // pattern stays fixed relative to the screen, not the object.
    vec2 pixel_pos = FRAGCOORD.xy / dither_scale;
    float dither = get_bayer_value(pixel_pos);

    // Once the local amount exceeds this pixel's dither threshold, drop it.
    if (local_amount > dither) {
        discard;
    }

    COLOR = tex_color;
}
